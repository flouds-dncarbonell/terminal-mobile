# Optional. Copy to .env; serve.sh loads this shell configuration.
# Paths and values containing spaces must be quoted.
# TERMINAL_MOBILE_PROJECT="$HOME/projects"
TERMINAL_MOBILE_SOCKET=terminal-mobile
# If ttyd is not copied to ./ttyd, set its absolute installed path:
# TERMINAL_MOBILE_TTYD=/usr/bin/ttyd
# Set your own contact for Web Push:
# TERMINAL_MOBILE_PUSH_CONTACT=mailto:you@example.com
